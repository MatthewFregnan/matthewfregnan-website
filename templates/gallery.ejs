<%- include('partials/header') %>

<section class="py-12">
  <div class="container mx-auto px-4">
    <!-- Page Title -->
    <h1 class="text-3xl md:text-4xl font-light text-center <%= text['intro_' + category.id] ? 'mb-3' : 'mb-12' %>">
      <%= category.name %>
    </h1>
    <% if (text['intro_' + category.id]) { %><p class="section-intro"><%= text['intro_' + category.id] %></p><% } %>

    <!-- Portfolio Grid -->
    <div class="<%= category.id === 'vertical' ? 'portfolio-grid-vertical' : 'portfolio-grid' %>">
      <% projects.forEach(project => { %>
        <%- include('partials/card', { project, category, vertical: category.id === 'vertical' }) %>
      <% }) %>
    </div>

    <% if (projects.length === 0) { %>
      <p class="text-center text-site-text-muted py-12">
        No projects in this category yet.
      </p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
