<%- include('partials/header') %>

<section class="py-12">
  <div class="container mx-auto px-4">
    <!-- Page Title -->
    <h1 class="text-3xl md:text-4xl font-light text-center <%= text['intro_' + category.id] ? 'mb-3' : 'mb-12' %>">
      <%= category.name %>
    </h1>
    <% if (text['intro_' + category.id]) { %><p class="section-intro"><%= text['intro_' + category.id] %></p><% } %>

    <%# Client filter: chips for clients with two or more projects here (only when there are at least two
        such clients). Picking one shows just that client's work; ?client=<name> links straight to it.
        It and the counts on it can be switched off per page on the admin's Pages screen (pageOptions). %>
    <% const byClient = new Map();
       projects.forEach(p => { const n = String(p.client || '').trim(); if (n) byClient.set(n, (byClient.get(n) || 0) + 1); });
       const chips = [...byClient].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]); %>
    <% if (chips.length >= 2 && pageOptions.clientFilter) { %>
    <div class="client-chips" role="group" aria-label="Show work for one client">
      <button type="button" class="client-chip is-on" data-chip="">All</button>
      <% chips.forEach(([name, n]) => { %><button type="button" class="client-chip" data-chip="<%= name.toLowerCase() %>"><%= name %><% if (pageOptions.filterCounts) { %> <span><%= n %></span><% } %></button><% }) %>
    </div>
    <% } %>

    <!-- Portfolio Grid -->
    <div class="<%= category.id === 'vertical' ? 'portfolio-grid-vertical' : 'portfolio-grid' %>">
      <% projects.forEach(project => { %>
        <%- include('partials/card', { project, category, vertical: category.id === 'vertical' }) %>
      <% }) %>
    </div>

    <% if (projects.length === 0) { %>
      <p class="text-center text-site-text-muted py-12">
        No projects in this category yet.
      </p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
