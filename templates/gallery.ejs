<%- include('partials/header') %>

<section class="py-12">
  <div class="container mx-auto px-4">
    <!-- Page Title -->
    <h1 class="text-3xl md:text-4xl font-light mb-12 text-center">
      <%= category.name %>
    </h1>

    <!-- Portfolio Grid -->
    <div class="<%= category.slug === 'vertical' ? 'portfolio-grid-vertical' : 'portfolio-grid' %>">
      <% projects.forEach(project => { %>
        <%- include('partials/card', { project, category, vertical: category.slug === 'vertical' }) %>
      <% }) %>
    </div>

    <% if (projects.length === 0) { %>
      <p class="text-center text-site-text-muted py-12">
        No projects in this category yet.
      </p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
