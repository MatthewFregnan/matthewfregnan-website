<%- include('partials/header') %>

<!-- Hero Section with Video Background -->
<section class="relative min-h-screen flex items-center justify-center overflow-hidden -mt-16">
  <!-- Background video: a silent self-hosted loop (no player controls). Set in data/site.json. -->
  <div class="absolute inset-0 w-full h-full">
    <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden" aria-hidden="true">
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover"
        src="<%= site.heroVideo %>"
        poster="<%= site.heroPoster %>"
        autoplay muted loop playsinline disablepictureinpicture disableremoteplayback
        preload="auto"
        tabindex="-1"
      ></video>
    </div>
    <!-- Dark overlay for text readability -->
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 container mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-light mb-6">
      <%= site.title %>
    </h1>
    <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto">
      <%= site.tagline %>
    </p>
    <div class="mt-12">
      <a href="/my-work/" class="inline-block border border-white/50 px-8 py-3 text-sm uppercase tracking-wider hover:bg-white hover:text-site-bg transition-all duration-300">
        View My Work
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
