<%- include('partials/header') %>

<!-- Hero Section with Video Background -->
<section class="hero relative flex items-center justify-center -mt-16">
  <!-- Background video: a silent self-hosted loop (no player controls). Set in data/site.json.
       It stays behind the whole page; as you scroll it zooms in, blurs and darkens (src/main.js). -->
  <div class="hero-bg" id="hero-bg" aria-hidden="true">
    <div class="hero-media" id="hero-media">
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover"
        src="<%= site.heroVideo %>"
        poster="<%= site.heroPoster %>"
        autoplay muted loop playsinline disablepictureinpicture disableremoteplayback
        preload="auto"
        tabindex="-1"
      ></video>
    </div>
    <!-- Darkening: an even shade, plus a fade at the bottom of the hero into the work below -->
    <div class="hero-shade" id="hero-shade"></div>
    <div class="hero-fade" id="hero-fade"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 container mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-light mb-6">
      <%= site.title %>
    </h1>
    <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto">
      <%= (home.tagline || site.tagline) %>
    </p>
    <div class="mt-12">
      <a href="<%= home.landscape.length || home.vertical.length ? '#selected-work' : '/my-work/' %>" class="inline-block rounded-full border border-white/50 px-8 py-3 text-sm uppercase tracking-wider hover:bg-white hover:text-site-bg transition-all duration-300">
        <%= text.heroButton %>
      </a>
    </div>
  </div>

  <% if (clientStrip.length > 2) { %>
    <%# Clients worked with: rises and fades in soon after the page opens, then drifts slowly sideways.
        The clients ticked for it in the admin (see clientLogos in build.js), each sized to its shape. %>
    <% if (text.clientsLabel) { %><p class="hero-clients-label"><%= text.clientsLabel %></p><% } %>
    <div class="hero-clients" aria-label="<%= text.clientsLabel || 'Clients' %>">
      <div class="hero-clients-rise"><div class="hero-clients-track">
        <% [0, 1].forEach(copy => { %>
          <div class="hero-clients-set"<% if (copy) { %> aria-hidden="true"<% } %>>
            <% clientStrip.forEach(c => { %><img src="<%= c.src %>" alt="<%= copy ? '' : c.name %>" decoding="async" style="height: <%= c.height %>px"><% }) %>
          </div>
        <% }) %>
      </div></div>
    </div>
  <% } %>

  <% if (home.landscape.length || home.vertical.length) { %>
    <!-- Nudge to scroll: bounces gently, fades out once you scroll -->
    <a href="#selected-work" class="scroll-cue" aria-label="Scroll to featured work">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </a>
  <% } %>
</section>

<% if (home.landscape.length || home.vertical.length) { %>
<!-- Selected work: chosen in the desktop app or web admin (data/home.json) -->
<section id="selected-work" class="pb-16 scroll-mt-16">
  <div class="container mx-auto px-4">
    <div class="work-head">
      <h2 class="text-xl md:text-2xl font-light"><%= home.heading %></h2>
    </div>
    <%
      // The two rows, in the order chosen for this set. The first row's title sits just under the
      // heading; later rows get a bit more space above them.
      const rows = [
        { kind: 'landscape', items: home.landscape, title: home.landscapeTitle },
        { kind: 'social', items: home.vertical, title: home.socialTitle },
      ].filter(r => r.items.length);
      if (home.order === 'social-first') rows.reverse();
    %>
    <% rows.forEach((row, i) => { %>
      <% if (row.title) { %>
        <h3 class="text-base font-light text-site-text-muted <%= i === 0 ? 'mt-1' : 'mt-10' %> mb-4"><%= row.title %></h3>
      <% } else if (i > 0) { %>
        <div class="mt-10"></div>
      <% } %>
      <%
        // Every row scrolls sideways like a streaming service: when the tiles all fit they share the row,
        // otherwise a slice of the next one peeks in and arrows appear (swipe on phones). See .row-scroller.
        const landscape = row.kind === 'landscape';
        const settings = landscape ? home.featured : home.reels;
        const n = settings.shown;
        const fit = landscape
          ? [n <= 1 && 'fit-base', n <= 2 && 'fit-sm', n <= 3 && 'fit-lg', n <= 3 && 'fit-xl']
          : [n <= 2 && 'fit-base', n <= 3 && 'fit-sm', n <= 4 && 'fit-lg', n <= 5 && 'fit-xl'];
        const rowId = landscape ? 'featured' : 'reels';
      %>
      <div class="row-scroller <%= landscape ? 'is-landscape' : 'is-portrait' %> <%= fit.filter(Boolean).join(' ') %>" style="--n: <%= n %>" data-scroller>
        <button type="button" class="scroller-btn prev" aria-label="Scroll back" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <div class="row-track" id="<%= rowId %>"<% if (settings.shuffle) { %> data-count="<%= n %>" data-shuffle<% } %>>
          <% row.items.forEach(({ project, category, pinned, soft, shown }) => { %>
            <%- include('partials/card', { project, category, vertical: !landscape,
              extra: (pinned ? 'data-pinned ' : '') + (soft ? 'data-soft ' : '') + (shown ? '' : 'hidden') }) %>
          <% }) %>
        </div>
        <button type="button" class="scroller-btn next" aria-label="Scroll forward" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
      <% if (settings.shuffle) { %>
      <script>
        // Shuffle: pinned projects keep their place; soft-pinned ones fill the first free places (in a random
        // order); every other place gets a random project from the rest.
        // Runs before the row is drawn.
        (function () {
          var row = document.getElementById('<%= rowId %>');
          var cards = [].slice.call(row.children);
          var n = +row.dataset.count;
          var fixed = {};
          cards.forEach(function (c, i) { if (i < n && c.hasAttribute('data-pinned')) fixed[i] = c; });
          var mix = function (list) {
            for (var i = list.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = list[i]; list[i] = list[j]; list[j] = t; }
            return list;
          };
          // soft-pinned projects first (in a random order), then the rest
          var free = cards.filter(function (c, i) { return !(i < n && c.hasAttribute('data-pinned')); });
          var pool = mix(free.filter(function (c) { return c.hasAttribute('data-soft'); }))
            .concat(mix(free.filter(function (c) { return !c.hasAttribute('data-soft'); })));
          var out = [];
          for (var k = 0; k < n; k++) { var c = fixed[k] || pool.shift(); if (c) out.push(c); }
          cards.forEach(function (c) { c.hidden = out.indexOf(c) < 0; });
          out.forEach(function (c) { row.appendChild(c); });
          cards.forEach(function (c) { if (c.hidden) row.appendChild(c); });
        })();
      </script>
      <% } %>
    <% }) %>

    <!-- Everything else: one picture tile per category -->
    <h3 class="text-base font-light text-site-text-muted mt-12 mb-4">All work</h3>
    <div class="category-tiles">
      <% home.categoryTiles.forEach(({ category: c, count, thumbs }, i) => { %>
        <a href="/<%= c.slug %>/" class="category-tile" data-cycle-offset="<%= i %>">
          <span class="category-tile-images" aria-hidden="true">
            <% thumbs.forEach((t, n) => { %><img src="<%= imageUrl('thumbnails', t.src) %>" alt="" loading="lazy" class="<%= n === 0 ? 'is-on' : '' %>"<% if (t.focus) { %> style="object-position: <%= t.focus %>"<% } %>><% }) %>
          </span>
          <span class="category-tile-text">
            <span class="category-tile-name"><%= c.name %></span>
            <span class="category-tile-count"><%= count %> projects</span>
          </span>
        </a>
      <% }) %>
    </div>

    <%# Where to next: a bit about me %>
    <a href="/about/" class="home-about">
      <img src="<%= imageUrl('', 'headshot.jpg').replace('/images//', '/images/') %>" alt="" loading="lazy">
      <span class="home-about-text">
        <span class="home-about-title"><%= text.homeAboutTitle %></span>
        <span class="home-about-sub"><%= text.homeAboutText %></span>
      </span>
      <span class="home-about-go"><%= text.homeAboutButton %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </a>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
