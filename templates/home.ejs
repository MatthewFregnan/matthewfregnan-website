<%- include('partials/header') %>

<!-- Hero Section with Video Background -->
<section class="hero relative flex items-center justify-center overflow-hidden -mt-16">
  <!-- Background video: a silent self-hosted loop (no player controls). Set in data/site.json. -->
  <div class="absolute inset-0 w-full h-full">
    <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden" aria-hidden="true">
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover"
        src="<%= site.heroVideo %>"
        poster="<%= site.heroPoster %>"
        autoplay muted loop playsinline disablepictureinpicture disableremoteplayback
        preload="auto"
        tabindex="-1"
      ></video>
    </div>
    <!-- Dark overlay for text readability -->
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 container mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-light mb-6">
      <%= site.title %>
    </h1>
    <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto">
      <%= (home.tagline || site.tagline) %>
    </p>
    <div class="mt-12">
      <a href="<%= home.landscape.length || home.vertical.length ? '#selected-work' : '/my-work/' %>" class="inline-block border border-white/50 px-8 py-3 text-sm uppercase tracking-wider hover:bg-white hover:text-site-bg transition-all duration-300">
        View My Work
      </a>
    </div>
  </div>

  <% if (home.landscape.length || home.vertical.length) { %>
    <!-- Nudge to scroll: bounces gently, fades out once you scroll -->
    <a href="#selected-work" class="scroll-cue" aria-label="Scroll to selected work">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </a>
  <% } %>
</section>

<% if (home.landscape.length || home.vertical.length) { %>
<!-- Selected work: chosen in the desktop app or web admin (data/home.json) -->
<section id="selected-work" class="pt-8 pb-16 scroll-mt-20">
  <div class="container mx-auto px-4">
    <div class="work-head">
      <h2 class="text-xl md:text-2xl font-light">Selected Work</h2>
      <nav class="work-browse" aria-label="Browse all work by category">
        <span>Browse:</span>
        <% categories.forEach((c, i) => { %><a href="/<%= c.slug %>/"><%= c.name %></a><% if (i < categories.length - 1) { %><span aria-hidden="true">·</span><% } %><% }) %>
      </nav>
    </div>
    <% if (home.landscape.length) { %>
      <%# 4 across when that fills the rows evenly (4 or 8 projects), otherwise 3 %>
      <div class="portfolio-grid-home <%= home.landscape.length % 4 === 0 ? 'is-four' : '' %>">
        <% home.landscape.forEach(({ project, category }) => { %>
          <%- include('partials/card', { project, category, vertical: false }) %>
        <% }) %>
      </div>
    <% } %>
    <% if (home.vertical.length) { %>
      <h3 class="text-base font-light text-site-text-muted mt-10 mb-4">Social</h3>
      <div class="portfolio-grid-shortform">
        <% home.vertical.forEach(({ project, category }) => { %>
          <%- include('partials/card', { project, category, vertical: true }) %>
        <% }) %>
      </div>
    <% } %>

    <!-- Everything else: one picture tile per category -->
    <h3 class="text-base font-light text-site-text-muted mt-12 mb-4">All work</h3>
    <div class="category-tiles">
      <% home.categoryTiles.forEach(({ category: c, count, thumbs }, i) => { %>
        <a href="/<%= c.slug %>/" class="category-tile" data-cycle-offset="<%= i %>">
          <span class="category-tile-images" aria-hidden="true">
            <% thumbs.forEach((t, n) => { %><img src="/images/thumbnails/<%= t %>" alt="" loading="lazy" class="<%= n === 0 ? 'is-on' : '' %>"><% }) %>
          </span>
          <span class="category-tile-text">
            <span class="category-tile-name"><%= c.name %></span>
            <span class="category-tile-count"><%= count %> projects</span>
          </span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
