<%- include('partials/header') %>

<!-- Hero Section with Video Background -->
<section class="hero relative flex items-center justify-center overflow-hidden -mt-16">
  <!-- Background video: a silent self-hosted loop (no player controls). Set in data/site.json. -->
  <div class="absolute inset-0 w-full h-full">
    <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden" aria-hidden="true">
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover"
        src="<%= site.heroVideo %>"
        poster="<%= site.heroPoster %>"
        autoplay muted loop playsinline disablepictureinpicture disableremoteplayback
        preload="auto"
        tabindex="-1"
      ></video>
    </div>
    <!-- Dark overlay for text readability -->
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 container mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-light mb-6">
      <%= site.title %>
    </h1>
    <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto">
      <%= (home.tagline || site.tagline) %>
    </p>
    <div class="mt-12">
      <a href="<%= home.landscape.length || home.vertical.length ? '#selected-work' : '/my-work/' %>" class="inline-block border border-white/50 px-8 py-3 text-sm uppercase tracking-wider hover:bg-white hover:text-site-bg transition-all duration-300">
        View My Work
      </a>
    </div>
  </div>

  <% if (home.landscape.length || home.vertical.length) { %>
    <!-- Nudge to scroll: bounces gently, fades out once you scroll -->
    <a href="#selected-work" class="scroll-cue" aria-label="Scroll to selected work">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </a>
  <% } %>
</section>

<% if (home.landscape.length || home.vertical.length) { %>
<!-- Selected work: chosen in the desktop app or web admin (data/home.json) -->
<section id="selected-work" class="pt-8 pb-16 scroll-mt-20">
  <div class="container mx-auto px-4">
    <div class="work-head">
      <h2 class="text-xl md:text-2xl font-light"><%= home.heading %></h2>
      <nav class="work-browse" aria-label="Browse all work by category">
        <span>Browse:</span>
        <% categories.forEach((c, i) => { %><a href="/<%= c.slug %>/"><%= c.name %></a><% if (i < categories.length - 1) { %><span aria-hidden="true">·</span><% } %><% }) %>
      </nav>
    </div>
    <%
      // The two rows, in the order chosen for this set. The first row's title sits just under the
      // heading; later rows get a bit more space above them.
      const rows = [
        { kind: 'landscape', items: home.landscape, title: home.landscapeTitle },
        { kind: 'social', items: home.vertical, title: home.socialTitle },
      ].filter(r => r.items.length);
      if (home.order === 'social-first') rows.reverse();
    %>
    <% rows.forEach((row, i) => { %>
      <% if (row.title) { %>
        <h3 class="text-base font-light text-site-text-muted <%= i === 0 ? 'mt-1' : 'mt-10' %> mb-4"><%= row.title %></h3>
      <% } else if (i > 0) { %>
        <div class="mt-10"></div>
      <% } %>
      <% if (row.kind === 'landscape') { %>
        <%# 4 across when that fills the rows evenly (4 or 8 projects), otherwise 3 %>
        <div id="featured" class="portfolio-grid-home <%= home.landscapeShown % 4 === 0 ? 'is-four' : '' %>"
          <% if (home.featured.count && home.featured.shuffle) { %>data-count="<%= home.featured.count %>" data-shuffle<% } %>>
          <% row.items.forEach(({ project, category, locked, shown }) => { %>
            <%- include('partials/card', { project, category, vertical: false,
              extra: (locked ? 'data-locked ' : '') + (shown ? '' : 'hidden') }) %>
          <% }) %>
        </div>
        <% if (home.featured.count && home.featured.shuffle) { %>
        <script>
          // Shuffle: keep the locked projects and fill the other places at random, before the row is drawn
          (function () {
            var grid = document.getElementById('featured');
            var cards = [].slice.call(grid.children);
            var n = +grid.dataset.count;
            var locked = cards.filter(function (c) { return c.hasAttribute('data-locked'); }).slice(0, n);
            var rest = cards.filter(function (c) { return locked.indexOf(c) < 0; });
            for (var i = rest.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = rest[i]; rest[i] = rest[j]; rest[j] = t; }
            var pick = locked.concat(rest.slice(0, n - locked.length));
            cards.forEach(function (c) { c.hidden = pick.indexOf(c) < 0; });
          })();
        </script>
        <% } %>
      <% } else { %>
        <%# One row. When they all fit (up to 2 on phones, 3 on tablets, 4 on laptops, 5 on desktops) they
            share the row; any more and it scrolls: arrows on wider screens, swipe on phones. %>
        <% const n = row.items.length;
           const fit = [n <= 2 && 'fit-base', n <= 3 && 'fit-sm', n <= 4 && 'fit-lg', n <= 5 && 'fit-xl'].filter(Boolean).join(' '); %>
        <div class="shortform-scroller <%= fit %>" style="--n: <%= n %>" data-scroller>
          <button type="button" class="scroller-btn prev" aria-label="Scroll back" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <div class="shortform-track">
            <% row.items.forEach(({ project, category }) => { %>
              <%- include('partials/card', { project, category, vertical: true }) %>
            <% }) %>
          </div>
          <button type="button" class="scroller-btn next" aria-label="Scroll forward" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      <% } %>
    <% }) %>

    <!-- Everything else: one picture tile per category -->
    <h3 class="text-base font-light text-site-text-muted mt-12 mb-4">All work</h3>
    <div class="category-tiles">
      <% home.categoryTiles.forEach(({ category: c, count, thumbs }, i) => { %>
        <a href="/<%= c.slug %>/" class="category-tile" data-cycle-offset="<%= i %>">
          <span class="category-tile-images" aria-hidden="true">
            <% thumbs.forEach((t, n) => { %><img src="/images/thumbnails/<%= t.src %>" alt="" loading="lazy" class="<%= n === 0 ? 'is-on' : '' %>"<% if (t.focus) { %> style="object-position: <%= t.focus %>"<% } %>><% }) %>
          </span>
          <span class="category-tile-text">
            <span class="category-tile-name"><%= c.name %></span>
            <span class="category-tile-count"><%= count %> projects</span>
          </span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
