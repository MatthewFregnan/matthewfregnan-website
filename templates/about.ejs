<%- include('partials/header') %>

<%# Backdrop: the foliage from the headshot (person removed), blurred and darkened, behind the page
    like the home page's video. Made from images/headshot.jpg; see images/about-bg.webp. %>
<div class="page-backdrop" aria-hidden="true" style="background-image: url('<%= imageUrl('', 'about-bg.webp').replace('/images//', '/images/') %>')"></div>

<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-5 gap-10 md:gap-14 max-w-5xl mx-auto items-start">
      <!-- Headshot -->
      <div class="md:col-span-2">
        <img
          src="/images/headshot.jpg"
          alt="<%= site.title %>"
          class="w-full max-w-sm mx-auto rounded-lg"
        >
      </div>

      <!-- Bio -->
      <div class="md:col-span-3">
        <h1 class="text-3xl md:text-4xl font-light mb-6">Hi, I’m Matthew!</h1>

        <div class="space-y-4 text-site-text-muted leading-relaxed">
          <p>
            I'm a post-production professional with over 5 years of experience based in Melbourne, Australia.
            I specialize in editing diverse content types, from commercial campaigns to branded videos and social media content.
          </p>

          <p>
            My portfolio includes work with major brands such as KIA, Redoctane Games, CRKD, Deakin University,
            Ladbrokes, Oporto, and Australian government agencies. I focus on creating content that tells a story
            with clarity, energy, and style.
          </p>
        </div>

        <div class="about-block">
          <h2 class="about-label">Education</h2>
          <ul class="space-y-2">
            <li>
              <span class="block">Bachelor of Film and Television (Honours)</span>
              <span class="text-sm text-site-text-muted">Swinburne University · 2018–2019</span>
            </li>
            <li>
              <span class="block">Advanced Diploma &amp; Diploma of Screen and Media</span>
              <span class="text-sm text-site-text-muted">Swinburne University · 2016–2017</span>
            </li>
          </ul>
        </div>

        <div class="about-block">
          <h2 class="about-label">Get in touch</h2>
          <ul class="space-y-2">
            <li>
              <a href="mailto:<%= site.email %>" class="about-link with-icon"><%- include('partials/icon-mail') %><%= site.email %></a>
            </li>
            <% if (site.social && site.social.linkedin) { %>
              <li>
                <a href="<%= site.social.linkedin %>" class="about-link" target="_blank" rel="noopener">LinkedIn</a>
              </li>
            <% } %>
            <li class="text-site-text-muted with-icon"><%- include('partials/icon-globe') %><%= site.location %></li>
          </ul>
        </div>

        <%# Keep people moving: from here into the work %>
        <div class="about-block">
          <a href="/<%= (categories.find(c => c.id === 'commercial') || categories[0]).slug %>/" class="about-cta">
            See my commercial work
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
