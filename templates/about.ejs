<%- include('partials/header') %>

<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-5 gap-10 md:gap-14 max-w-5xl mx-auto items-start">
      <!-- Headshot -->
      <div class="md:col-span-2">
        <img
          src="/images/headshot.jpg"
          alt="<%= site.title %>"
          class="w-full max-w-sm mx-auto rounded-lg"
        >
      </div>

      <!-- Bio -->
      <div class="md:col-span-3">
        <h1 class="text-3xl md:text-4xl font-light mb-6">About</h1>

        <div class="space-y-4 text-site-text-muted leading-relaxed">
          <p>
            I'm a video editor and colourist based in Melbourne. Since 2019 I've worked in-house at
            production companies and agencies, including ThinkHQ, Elastic Studios and Robot Army / Milk Video,
            editing TVCs, branded content and social for clients like KIA, Ladbrokes, Oporto, Deakin University,
            RedOctane Games and CRKD, as well as campaigns for the Victorian and Federal Governments.
          </p>
          <p>
            Most of my time is spent in the edit, finding the story and getting the pacing right, but I also grade
            a lot of what I cut, and I enjoy the technical side of post: finishing, delivery, and setting up
            workflows that save everyone time.
          </p>
        </div>

        <div class="about-block">
          <h2 class="about-label">What I do</h2>
          <ul class="about-tags">
            <li>Editing: TVC, branded &amp; social</li>
            <li>Colour grading</li>
            <li>Motion graphics</li>
            <li>Sound editing</li>
            <li>Workflow automation</li>
          </ul>
        </div>

        <div class="about-block">
          <h2 class="about-label">Tools</h2>
          <p class="text-site-text-muted">
            Premiere Pro · DaVinci Resolve Studio · After Effects · Audition · Photoshop · Final Cut Pro ·
            Avid Media Composer · Pro Tools
          </p>
        </div>

        <div class="about-block">
          <h2 class="about-label">Education</h2>
          <ul class="space-y-2">
            <li>
              <span class="block">Bachelor of Film and Television (Honours)</span>
              <span class="text-sm text-site-text-muted">Swinburne University · 2018–2019</span>
            </li>
            <li>
              <span class="block">Advanced Diploma &amp; Diploma of Screen and Media</span>
              <span class="text-sm text-site-text-muted">Swinburne University · 2016–2017</span>
            </li>
          </ul>
        </div>

        <div class="about-block">
          <h2 class="about-label">Get in touch</h2>
          <ul class="space-y-2">
            <li>
              <a href="mailto:<%= site.email %>" class="about-link"><%= site.email %></a>
            </li>
            <% if (site.social && site.social.linkedin) { %>
              <li>
                <a href="<%= site.social.linkedin %>" class="about-link" target="_blank" rel="noopener">LinkedIn</a>
              </li>
            <% } %>
            <li class="text-site-text-muted"><%= site.location %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
