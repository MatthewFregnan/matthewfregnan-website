  <%# Closing call to action on every page except About (which has its own "Get in touch"). On the home
      page it sits beside a short "about me", so the page ends with one row offering both next steps. %>
  <% if (activePage !== 'about') { %>
  <section class="closing-cta<%= activePage === 'home' ? ' is-duo' : '' %>">
    <div class="container mx-auto px-4">
      <% if (activePage === 'home') { %>
      <%# Phones (src/main.js turns this on): instead of the two cards, a "peek" bar you swipe up (or tap)
          to open a sheet with your photo, a line about you, About me and Get in touch. %>
      <button type="button" class="about-peek" aria-haspopup="dialog" aria-controls="about-sheet">
        <span class="about-peek-handle" aria-hidden="true"></span>
        <img src="<%= imageUrl('', 'headshot.jpg').replace('/images//', '/images/') %>" alt="" loading="lazy">
        <span class="about-peek-text"><span class="duo-title"><%= text.homeAboutTitle %></span><span class="about-peek-hint"><%= text.aboutPeekHint %></span></span>
        <svg class="about-peek-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
      </button>
      <div class="closing-duo">
        <a href="/about/" class="duo-about">
          <img src="<%= imageUrl('', 'headshot.jpg').replace('/images//', '/images/') %>" alt="" loading="lazy">
          <span class="duo-text">
            <span class="duo-title"><%= text.homeAboutTitle %></span>
            <span class="duo-sub"><%= text.homeAboutText %></span>
          </span>
          <span class="duo-btn"><%= text.homeAboutButton %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
        <div class="duo-contact">
          <span class="duo-text">
            <span class="duo-title"><%= text.ctaHeading %></span>
            <span class="duo-sub"><%= text.ctaText %></span>
          </span>
          <a href="mailto:<%= site.email %>" class="closing-cta-btn" data-contact><%= text.ctaButton %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
      <% } else { %>
      <h2 class="closing-cta-title"><%= text.ctaHeading %></h2>
      <p class="closing-cta-text"><%= text.ctaText %></p>
      <a href="mailto:<%= site.email %>" class="closing-cta-btn" data-contact><%= text.ctaButton %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <% } %>
    </div>
  </section>
  <% } %>
  </main>

  <!-- Footer -->
  <footer class="site-footer border-t border-white/10 py-8">
    <%# Back to top: sits centred on the footer's top line (a spot nothing else uses on any page or screen),
        rising in when you reach the bottom. %>
    <button type="button" class="to-top" aria-label="Back to top" data-to-top>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
    </button>
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row items-center justify-between text-sm text-site-text-muted">
        <div class="text-center md:text-left">
          <p class="footer-facts">
            <span class="with-icon"><%- include('icon-globe') %><%= site.location %></span>
            <a href="mailto:<%= site.email %>" class="hover:text-site-text with-icon" data-contact><%- include('icon-mail') %><%= site.email %></a>
          </p>
        </div>
        <p class="mt-2 md:mt-0">&copy; <%= currentYear %> <%= site.title %>. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <% if (activePage === 'home') { %>
  <div class="about-sheet" id="about-sheet" hidden>
    <div class="about-sheet-backdrop" data-sheet-close></div>
    <div class="about-sheet-panel" role="dialog" aria-modal="true" aria-label="<%= text.homeAboutTitle %>">
      <span class="about-sheet-handle" aria-hidden="true"></span>
      <img class="about-sheet-photo" src="<%= imageUrl('', 'headshot.jpg').replace('/images//', '/images/') %>" alt="<%= site.title %>" loading="lazy">
      <h2 class="about-sheet-title"><%= text.homeAboutTitle %></h2>
      <p class="about-sheet-text"><%= text.homeAboutText %></p>
      <div class="about-sheet-actions">
        <a href="/about/" class="contact-btn"><%= text.homeAboutButton %></a>
        <a href="mailto:<%= site.email %>" class="contact-btn primary" data-contact><%= text.ctaButton %></a>
      </div>
    </div>
  </div>
  <% } %>

  <%# Contact panel: opened by any link marked data-contact (the links still work as plain email links
      without JavaScript). Copy the address, open your mail app, or go to LinkedIn. %>
  <dialog id="contact-panel" class="contact-panel" aria-labelledby="contact-title">
    <button type="button" class="contact-close" aria-label="Close" data-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <h2 id="contact-title" class="contact-title"><%= text.contactHeading %></h2>
    <% if (text.availability) { %><p class="contact-availability"><span class="contact-dot" aria-hidden="true"></span><%= text.availability %></p><% } %>
    <p class="contact-text"><%= text.contactText %></p>
    <%# Message form: sent to the upload service (upload-worker, POST /message), saved for the admin's Inbox
        and emailed to me. The "website" field is hidden from people; only bots fill it in. %>
    <form class="contact-form" data-message-form novalidate>
      <div class="cf-row">
        <label class="cf-field"><span class="sr-only">Your name</span><input name="name" type="text" placeholder="Your name" autocomplete="name" maxlength="100" required></label>
        <label class="cf-field"><span class="sr-only">Your email</span><input name="email" type="email" placeholder="Your email" autocomplete="email" maxlength="200" required></label>
      </div>
      <label class="cf-field"><span class="sr-only">Message</span><textarea name="message" rows="4" placeholder="<%= text.messagePlaceholder %>" maxlength="5000" required></textarea></label>
      <label class="cf-trap" aria-hidden="true">Website <input name="website" type="text" tabindex="-1" autocomplete="off"></label>
      <p class="cf-error" role="alert" hidden></p>
      <button type="submit" class="contact-btn primary cf-send">Send Message</button>
    </form>
    <div class="cf-sent" role="status" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      <p><%= text.messageSent %></p>
    </div>
    <p class="contact-or"><span>or email me</span></p>
    <div class="contact-email">
      <span class="with-icon"><%- include('icon-mail') %><span data-email><%= site.email %></span></span>
      <button type="button" class="contact-copy" data-copy>Copy</button>
    </div>
    <div class="contact-actions">
      <a href="mailto:<%= site.email %>" class="contact-btn">Open in Mail</a>
      <% if (site.social && site.social.linkedin) { %><a href="<%= site.social.linkedin %>" class="contact-btn" target="_blank" rel="noopener">LinkedIn</a><% } %>
    </div>
    <p class="contact-where with-icon"><%- include('icon-globe') %><%= site.location %></p>
  </dialog>

  <script src="/js/main.js?v=<%= assetVersion.js %>"></script>
</body>
</html>
