<%# Views / likes / comments: one line each with a small icon (Lucide "eye", "heart", "message-circle";
    lucide.dev, ISC licence). Live counts belong to one video source, so src/main.js removes them if the page
    falls back to another; typed numbers always stay. %>
<% if (project._stats) { const s = project._stats;
   const icon = {
     view: '<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>',
     like: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
     comment: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
   }; %>
<div class="stats-fact" data-stats-kind="<%= s.kind %>"<% if (s.typed) { %> data-typed<% } %>>
  <dt class="text-site-text-muted"><% if (s.where) { %>On <% if (s.link) { %><a href="<%= s.link %>" target="_blank" rel="noopener" class="stats-link"><%= s.where %></a><% } else { %><%= s.where %><% } %><% } else { %>Reach<% } %></dt>
  <dd>
    <ul class="stats-lines">
      <% s.lines.forEach(l => { %><li><svg class="stats-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icon[l.kind] %></svg><span class="stats-n"><%= l.n %></span> <span class="stats-w"><%= l.word %></span></li><% }) %>
    </ul>
  </dd>
</div>
<% } %>
