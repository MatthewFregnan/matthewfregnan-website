<%# Views / likes / comments: one line per number, so the reach reads at a glance. Live counts belong to one
    video source, so src/main.js removes them if the page falls back to another; typed numbers always stay. %>
<% if (project._stats) { const s = project._stats; %>
<div class="stats-fact" data-stats-kind="<%= s.kind %>"<% if (s.typed) { %> data-typed<% } %>>
  <dt class="text-site-text-muted"><% if (s.where) { %>On <% if (s.link) { %><a href="<%= s.link %>" target="_blank" rel="noopener" class="stats-link"><%= s.where %></a><% } else { %><%= s.where %><% } %><% } else { %>Reach<% } %></dt>
  <dd>
    <ul class="stats-lines">
      <% s.lines.forEach(l => { %><li><span class="stats-n"><%= l.n %></span> <span class="stats-w"><%= l.word %></span></li><% }) %>
    </ul>
  </dd>
</div>
<% } %>
