<%# One project tile. Expects: project, category, vertical (bool), optional extra (raw attributes). Tiles with a hosted
    video play a silent preview on hover (see "Hover previews" in src/main.js). %>
<a href="/<%= category.slug %>/<%= project.id %>/"
   class="<%= vertical ? 'portfolio-item-vertical' : 'portfolio-item' %> group"
   <% if (project.videoFile) { %>data-preview="<%= project.videoFile %>"<% } %><%- typeof extra !== 'undefined' ? ' ' + extra : '' %>>
  <% if (project.thumbnail) { %>
  <img
    src="<%= imageUrl('thumbnails', project.thumbnail) %>"
    alt="<%= project.title %>"
    loading="lazy"
    <% if (focusOf(project)) { %>style="object-position: <%= focusOf(project) %>"<% } %>
  >
  <% } else if (project.videoFile) { %>
  <%# No thumbnail chosen yet: show a frame from the video instead of a broken image %>
  <video class="card-still" src="<%= project.videoFile.split('#')[0] %>#t=1" muted playsinline preload="metadata" aria-label="<%= project.title %>"></video>
  <% } else { %>
  <span class="card-still card-blank" aria-hidden="true"></span>
  <% } %>
  <% if (logoOf(project)) { %><img class="card-logo" src="<%= logoOf(project) %>" alt="<%= project.client %>" loading="lazy"><% } %>
  <div class="portfolio-item-title">
    <h2 class="text-lg font-medium"><%= project.title %></h2>
    <% if (project.client) { %>
      <p class="text-sm text-site-text-muted"><%= project.client %></p>
    <% } %>
  </div>
</a>
