<%# What I did: the project's roles (rolesOf in build.js), each with a small line icon. Expects: roles. %>
<ul class="role-list"><% roles.forEach(r => { %><li><% if (r.icon) { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- r.icon %></svg><% } %><%= r.label %></li><% }) %></ul>
