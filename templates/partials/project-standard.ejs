<%# Project page details: the original (stock) layout. %>
    <!-- Project Description -->
    <% if (project.description) { %>
      <div class="prose prose-invert max-w-none">
        <p class="text-site-text-muted"><%= project.description %></p>
      </div>
    <% } %>

    <!-- Project Details -->
    <% if (project.client || project.production || project.role || project.year || project._stats) { %>
      <div class="mt-8 pt-8 border-t border-white/10">
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <% if (project.client) { %>
            <div>
              <dt class="text-site-text-muted">Client</dt>
              <dd><%= project.client %></dd>
            </div>
          <% } %>
          <% if (project.production) { %>
            <div>
              <dt class="text-site-text-muted">Production</dt>
              <dd><%= project.production %></dd>
            </div>
          <% } %>
          <% const roles = rolesOf(project); if (roles.length) { %>
            <div class="md:col-span-2">
              <dt class="text-site-text-muted mb-2">What I did</dt>
              <dd><%- include('roles', { roles }) %></dd>
            </div>
          <% } %>
          <% if (project.year) { %>
            <div>
              <dt class="text-site-text-muted">Year</dt>
              <dd><%= project.year %></dd>
            </div>
          <% } %>
          <%- include('stats-fact', { project }) %>
        </dl>
      </div>
    <% } %>
