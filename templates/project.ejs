<%- include('partials/header') %>

<section class="py-12">
  <div class="container mx-auto px-4 max-w-5xl">
    <!-- Back Link -->
    <a href="/<%= category.slug %>/" class="inline-flex items-center text-site-text-muted hover:text-site-text mb-8 transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to <%= category.name %>
    </a>

    <%# Social (portrait) projects: on wider screens the video sits on the left, sized to fit the
        screen, with the title and details beside it (see .portrait-page in src/styles.css). %>
    <div class="<%= category.id === 'vertical' ? 'portrait-page' : '' %>">
    <!-- Project Title -->
    <h1 class="pp-title text-3xl md:text-4xl font-light mb-4">
      <%= project.title %>
    </h1>

    <% if (project.client) { %>
      <p class="pp-client text-site-text-muted mb-8"><%= project.client %></p>
    <% } %>

    <!-- Video: starts on the first working source. Hosted video files play in the site's own player
         (js/main.js); Vimeo / YouTube / Instagram / TikTok use their embeds. main.js swaps to a backup if one breaks. -->
    <% const video = project._video; %>
    <% if (video && video.sources.length) { %>
      <% const src = video.sources[video.active];
         const isVertical = category.id === 'vertical';
         const shape = src.kind === 'instagram' ? 'is-instagram' : (isVertical || src.kind === 'tiktok' ? 'is-vertical' : '');
         const poster = project.thumbnail ? `/images/thumbnails/${project.thumbnail}` : ''; %>
      <div class="pp-media video-player mb-8"
           data-video-sources="<%= JSON.stringify(video.sources.map(s => ({ kind: s.kind, embed: s.embed, check: s.check }))) %>"
           data-active="<%= video.active %>"
           data-vertical="<%= isVertical %>"
           data-poster="<%= poster %>"
           data-title="<%= project.title %>">
        <div class="player-shell <%= shape %>">
          <div class="video-container <%= shape %>">
            <% if (src.kind === 'file') { %>
              <video src="<%= src.embed %>" poster="<%= poster %>" preload="metadata" playsinline controls
                     aria-label="<%= project.title %>"></video>
            <% } else { %>
              <iframe
                src="<%= src.embed %>"
                title="<%= project.title %>"
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture; encrypted-media; clipboard-write"
                allowfullscreen
                loading="lazy"
              ></iframe>
            <% } %>
          </div>
        </div>
        <% if (project._stats) { %>
          <p class="video-stats" data-kind="<%= project._stats.kind %>"<% if (project._stats.typed) { %> data-typed<% } %>>
            <%= project._stats.text %><% if (project._stats.where) { %> on <% if (project._stats.link) { %><a href="<%= project._stats.link %>" target="_blank" rel="noopener" class="stats-link"><%= project._stats.where %></a><% } else { %><%= project._stats.where %><% } %><% } %>
          </p>
        <% } %>
      </div>
    <% } %>

    <!-- Image Gallery (for colour grading) -->
    <% if (project.gallery && project.gallery.length > 0) { %>
      <div class="pp-gallery space-y-4 mb-8">
        <% project.gallery.forEach((image, index) => { %>
          <img
            src="/images/gallery/<%= image %>"
            alt="<%= project.title %> - Image <%= index + 1 %>"
            class="w-full rounded-lg"
            loading="lazy"
          >
        <% }) %>
      </div>
    <% } %>

    <!-- Details: layout chosen per home page set (Standard or Detailed); see data/home.json -->
    <div class="pp-details">
    <%- include(projectLayout === 'detailed' ? 'partials/project-detailed' : 'partials/project-standard', { project }) %>
    </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
